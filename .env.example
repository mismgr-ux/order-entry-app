# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

PORT=3000

# ---- PostgreSQL settings ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=order_entry

# Set to "true" only for cloud databases (Neon, Supabase, Render) that require SSL.
# Leave "false" for your local PostgreSQL on this computer.
DB_SSL=false

# ---- Google Sheets settings ----
# Path to the service account JSON key file (see README for how to create this)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# The ID of your Google Sheet (found in its URL between /d/ and /edit)
SPREADSHEET_ID=your_google_sheet_id_here

# Sheet/tab name where rows should be appended
SHEET_NAME=Orders

# Google Drive folder ID where uploaded photos/PDFs will be stored
# (create a folder in Drive, share it with your service account email as Editor,
# then copy the ID from the folder's URL after /folders/)
# NOTE: not used anymore — replaced by Cloudinary below (service accounts on
# personal Gmail cannot store files directly in Drive).
DRIVE_FOLDER_ID=your_drive_folder_id_here

# ---- Google Drive via YOUR personal account (OAuth) ----
# Get these by creating an OAuth Client ID (Web application) in Google Cloud Console.
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
# The full public URL where this app is running (used for the OAuth redirect).
APP_BASE_URL=https://your-app.vercel.app
# Leave blank until you visit /auth-drive once and get this from the confirmation page.
OAUTH_REFRESH_TOKEN=
# Same Drive folder ID as before (share step no longer needed — it's your own folder).
DRIVE_FOLDER_ID=your_drive_folder_id_here

# ---- Cloudinary settings (used automatically as a fallback if Drive isn't set up) ----
# Sign up free at cloudinary.com, then copy these 3 values from your dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
